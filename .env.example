# Base de données
DATABASE_URL="postgresql://user:password@localhost:5432/formation_hub?schema=public"

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key-here

# JWT pour l'authentification des apprenants
JWT_SECRET=your-jwt-secret-key-here

# Configuration email (pour les notifications et réinitialisation de mot de passe)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
MAIL_FROM=noreply@example.com

# URL publique de l'application (pour les liens dans les emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000
